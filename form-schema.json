    {
      "id": "ai_use",
      "order": 12.0,
      "title": "Generative AI Use",
      "applies_to_kinds": [
        "traditional_review",
        "collaborative_peer_feedback",
        "classroom_testing",
        "approval_review"
      ],
      "items": [
        {
          "kind": "field",
          "order": 1.0,
          "id": "ai_use_intro",
          "section_id": "ai_use",
          "group_id": null,
          "label": "Generative AI can support activity development, but it should support \u2014 not replace \u2014 your own instructional design, disciplinary judgment, and critical thinking. As AI plays a larger role in producing content, the expectation for your review, verification, and disclosure increases. Select the level that best describes how AI was used in developing this activity. Routine or Supportive use covers things like brainstorming, wording suggestions, grammar/clarity checks, or formatting on work you conceived and directed. Substantive Developmental use means AI helped develop or revise real components \u2014 drafting objectives, generating questions from your objectives, building datasets, or suggesting scaffolding \u2014 requiring your careful review and verification. Extensive Generative use means AI generated substantial portions of the activity (e.g. a full question sequence or draft) with limited initial input from you.",
          "type": "info",
          "options": [],
          "required": "FALSE",
          "required_first_only": false,
          "required_for_kinds": [],
          "applies_to_kinds": [
            "all"
          ],
