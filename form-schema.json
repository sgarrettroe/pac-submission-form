    {
      "id": "implementation",
      "order": 6.0,
      "title": "POGIL Classroom Implementation",
      "applies_to_kinds": [
        "all"
      ],
      "fields": [
        {
          "id": "q8",
          "section_id": "implementation",
          "order": 1.0,
          "label": "Is this activity intended for use with the eight characteristics of the Basic POGIL Classroom Implementation? Check all that apply.",
          "type": "checkbox_group",
          "options": [
            {
              "value": "a",
              "label": "Students are expected to work cooperatively, generally in groups of three or four."
            },
            {
              "value": "b",
              "label": "The activity is a POGIL activity, specifically designed for POGIL implementation."
            },
            {
              "value": "c",
              "label": "The students work on the activity during class time with a facilitator present."
            },
            {
              "value": "d",
              "label": "The dominant mode of instruction is not lecture or instructor-centered; the instructor serves predominantly as a facilitator of student learning."
            },
            {
              "value": "e",
              "label": "Students have assigned roles within their groups."
            },
            {
              "value": "f",
              "label": "The activity is designed to be the first introduction to the topic or specific content."
            },
            {
              "value": "g",
              "label": "The students are not expected to have worked on any part of the activity prior to class meeting time."
            },
            {
              "value": "h",
              "label": "Groups are expected to complete all of the Critical Thinking Questions (or equivalently designated questions) during class, but they are not expected to work on any of the Exercises or Problems."
            }
          ],
          "required": "TRUE",
          "applies_to_kinds": [
            "all"
          ],
          "help_text": "",
          "show_if": null,
          "pdf": {
            "page_break_before": false,
            "pdf_format": "checklist"
          }
        },
        {
          "id": "q9",
          "section_id": "implementation",
          "order": 2.0,
          "label": "If you did not check boxes (a), (c), and (d) above, submit an implementation plan describing specifically how you implement this activity within your classroom.",
          "type": "textarea",
          "options": [],
          "required": "IF_VISIBLE",
          "applies_to_kinds": [
            "all"
          ],
          "help_text": "",
          "show_if": {
            "ref": "q8",
            "op": "not_all",
            "values": [
              "a",
              "c",
              "d"
            ]
          },
          "pdf": {
            "page_break_before": false,
            "pdf_format": "paragraph"
          }
        },
        {
          "id": "q10",
          "section_id": "implementation",
          "order": 3.0,
          "label": "For those boxes above that you did not check, briefly describe how and/or why your activity is not implemented in that way.",
          "type": "textarea",
          "options": [],
          "required": "IF_VISIBLE",
          "applies_to_kinds": [
            "all"
          ],
          "help_text": "",
          "show_if": {
            "ref": "q8",
            "op": "not_all",
            "values": [
              "a",
              "b",
              "c",
              "d",
              "e",
              "f",
              "g",
              "h"
            ]
          },
          "pdf": {
            "page_break_before": false,
            "pdf_format": "paragraph"
          }
        }
      ]
