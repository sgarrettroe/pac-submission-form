    {
      "id": "submission_kind",
      "order": 2.0,
      "pdf_order": 8.0,
      "title": "Submission Kind",
      "applies_to_kinds": [
        "all"
      ],
      "items": [
        {
          "kind": "field",
          "order": 1.0,
          "id": "submission_kind_intro",
          "section_id": "submission_kind",
          "group_id": null,
          "label": "The PAC supports activity writing across all stages of development.\n\n\u2022 ACTIVITY IDEAS are ideas, initial drafts, rough activities. Authors are seeking collaborators to work on these ideas to develop activities.\n\n\u2022 ACTIVITIES FOR REVIEW are complete activities. Authors are seeking formative feedback to improve the quality of the activity. \n\n\u2022 ACTIVITIES FOR TESTING are complete learning cycle or application activities that are ready for widespread classroom testing. Authors are seeking classroom testing feedback to optimize the activity.  \n\n\u2022 APPROVED ACTIVITIES are polished activities that have been revised based on classroom testing and meet the The POGIL Project's standards for a \"high-quality activity.\"\n\nWhat is your estimate for the stage of your activity?",
          "type": "info",
          "options": [],
          "required": "FALSE",
          "required_first_only": false,
          "required_for_kinds": [],
          "applies_to_kinds": [
            "all"
          ],
          "ui_style": "",
          "help_text": "",
          "show_if": null,
          "disabled_if": null,
          "pdf": {
            "page_break_before": false,
            "pdf_format": "paragraph"
          }
        },
        {
          "kind": "field",
          "order": 2.0,
          "id": "readiness",
          "section_id": "submission_kind",
          "group_id": null,
          "label": "Activity Readiness",
          "type": "radio",
          "options": [
            {
              "value": "activity_idea",
              "label": "Activity Idea"
            },
            {
              "value": "activity_for_review",
              "label": "Activity for Review"
            },
            {
              "value": "activity_for_testing",
              "label": "Activity for Testing"
            },
            {
              "value": "approved_activity",
              "label": "Approved Activity"
            }
          ],
          "required": "TRUE",
          "required_first_only": false,
          "required_for_kinds": [],
          "applies_to_kinds": [
            "all"
          ],
          "ui_style": "toggle",
          "help_text": "",
          "show_if": null,
          "disabled_if": null,
          "pdf": {
            "page_break_before": true,
            "pdf_format": "checklist"
          }
        }
      ]
    },
    {
      "id": "kind_of_feedback",
      "order": 3.0,
      "pdf_order": 9.0,
      "title": "Kind of Feedback",
      "applies_to_kinds": [
        "activity_for_review",
        "activity_for_testing",
        "approved_activity"
      ],
      "items": [
        {
          "kind": "field",
          "order": 1.0,
          "id": "review_kind_intro",
          "section_id": "kind_of_feedback",
          "group_id": null,
          "label": "The PAC offers several kinds of activity feedback.\n\n\u2022 TRADITIONAL REVIEW: Reviewers provide written feedback based on the appropriate rubric.\n\n\u2022 COLLABORATIVE ACTIVITY FEEDBACK: Authors meet virtually and share feedback with each other in a facilitated session.\n\n\u2022 CLASSROOM TESTING: Activities are sent to testers, who provide feedback based on their classroom experiences.\n\nWhat kind of review would you like?",
          "type": "info",
          "options": [],
          "required": "FALSE",
          "required_first_only": false,
          "required_for_kinds": [],
          "applies_to_kinds": [
            "all"
          ],
          "ui_style": "",
          "help_text": "",
          "show_if": null,
          "disabled_if": null,
          "pdf": {
            "page_break_before": false,
            "pdf_format": "paragraph"
          }
        },
        {
          "kind": "field",
