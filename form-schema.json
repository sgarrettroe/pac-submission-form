          "id": "review_kind",
          "section_id": "kind_of_feedback",
          "group_id": null,
          "label": "Kind of Review",
          "type": "radio",
          "options": [
            {
              "value": "traditional_review",
              "label": "Traditional Review"
            },
            {
              "value": "collaborative_peer_feedback",
              "label": "Collaborative Activity Feedback"
            },
            {
              "value": "classroom_testing",
              "label": "Classroom Testing"
            }
          ],
          "required": "TRUE",
          "required_first_only": false,
          "required_for_kinds": [],
          "applies_to_kinds": [
            "all"
          ],
          "ui_style": "toggle",
          "help_text": "",
