          "type": "radio",
          "options": [
            {
              "value": "no_ai",
              "label": "No AI was used"
            },
            {
              "value": "routine",
              "label": "Routine or Supportive use"
            },
            {
              "value": "substantive",
              "label": "Substantive development use"
