    {
      "id": "activity_idea",
      "display_name": "Activity Idea",
      "description": "Early-stage idea submission, before a full activity is developed."
    },
    {
      "id": "traditional_review",
      "display_name": "Traditional Review",
      "description": "Standard written review of a completed activity by PAC writing consultants."
    },
    {
      "id": "collaborative_peer_feedback",
      "display_name": "Collaborative Peer Feedback",
      "description": "Informal peer feedback exchange between authors ahead of formal review."
    },
    {
      "id": "classroom_testing",
      "display_name": "Classroom Testing",
      "description": "Activity is being piloted in a live classroom; submission centers on implementation and testing notes."
    },
    {
      "id": "approval_review",
      "display_name": "Approval Review",
      "description": "Final review for formal approval/designation as a vetted POGIL activity."
    }
