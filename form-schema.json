      "items": [
        {
          "kind": "field",
          "order": 1.0,
          "id": "ai_use_intro",
          "section_id": "ai_use",
          "group_id": null,
          "label": "Generative AI can support activity development, but it should support, not replace, your own instructional design, disciplinary judgment, and critical thinking. As AI plays a larger role in producing content, the expectation for your review, verification, and disclosure increases. Three levels of AI use are\n\n\u2022 ROUTINE or SUPPORTIVE use covers things like brainstorming, wording suggestions, grammar/clarity checks, or formatting on work you conceived and directed.\n\n\u2022 SUBSTANTIVE DEVELOPMENTAL use means AI helped develop or revise real components such as drafting objectives, generating questions from your objectives, building datasets, or suggesting scaffolding.\n\n\u2022 EXTENSIVE GENERATIVE use means AI generated substantial portions of the activity (e.g. a full question sequence or draft) with limited initial input from you.\n\n Select the level that best describes how AI was used in developing this activity.",
          "type": "info",
          "options": [],
